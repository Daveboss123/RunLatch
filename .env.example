# Public, non-secret configuration. LOCAL is a preview, not a chain result.
NEXT_PUBLIC_RUNLATCH_MODE=local
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_CONTRACT_ID=
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org

# Future local runner only. Never put a real key in this file or an .env file.
# Inject the approved scoped key privately into the runner's process instead.
RUNLATCH_AGENT_ACCOUNT_ID=
RUNLATCH_AGENT_PRIVATE_KEY=
RUNLATCH_ARTIFACT_DIR=.local/artifacts

# Optional future AI proposal adapter; not required by the deterministic demo.
AI_PROVIDER_API_KEY=
