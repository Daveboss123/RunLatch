{
  "name": "runlatch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "node scripts/web/next-local.mjs dev",
    "build": "node scripts/web/next-local.mjs build",
    "start": "node scripts/web/next-local.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/web tests/frontend playwright.config.ts --max-warnings=0",
    "test:frontend": "node --test tests/frontend/*.test.ts",
    "test:browser": "playwright test",
    "test:preview-parity": "node scripts/web/check-preview-parity.ts",
    "test": "node --test tests/validation/research.test.ts tests/validation/attestation.test.ts tests/validation/workflow-cli.test.ts tests/validation/resource.test.ts tests/validation/resource-cli.test.ts tests/hashes/quote.test.ts tests/hashes/commercial-quote.test.ts tests/intelligence/cohort.test.ts tests/purchasing/commitment.test.ts tests/reporting/project.test.ts",
    "test:hashes": "node --test tests/hashes/quote.test.ts",
    "test:validation": "node --test tests/validation/research.test.ts",
    "prepare:sandbox-reports": "node scripts/validation/prepare-sandbox-reports.ts",
    "analyze:local": "node scripts/workflow/analyze-local.ts",
    "validate:demo": "node scripts/validation/check-report.ts fixtures/research/valid-demo.json"
  },
  "dependencies": {
    "cn": "0.5.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
